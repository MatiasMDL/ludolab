# Variables de LudoLab Ebooks. Se cargan SOLO en Vercel → proyecto → Settings → Environment Variables.
# Nunca pongas los valores reales en este archivo ni en el repo (es público).

# Sitio
SITE_URL=https://ludolab.app

# Mercado Pago (Tus integraciones > tu aplicación > Credenciales de producción)
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx
# Clave secreta de webhooks (Tus integraciones > Webhooks). Recomendada.
MP_WEBHOOK_SECRET=

# Base de datos: Vercel → Storage → Upstash for Redis, conectada con prefijo KV. Las crea Vercel solo.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# PDFs privados: Vercel → Storage → Blob privado, conectado con prefijo EBOOKS y token de lectura/escritura. Lo crea Vercel solo.
EBOOKS_READ_WRITE_TOKEN=
# Solo para copiar el PDF viejo al Blob privado desde /admin y para links de descarga antiguos
PDF_URL=
# Texto largo y aleatorio; firma los links de descarga antiguos
DOWNLOAD_SECRET=

# Mail con Resend (resend.com). El dominio ludolab.app tiene que estar verificado.
RESEND_API_KEY=re_xxxxxxxx
# Opcional: por defecto "LudoLab Ebooks <hola@ludolab.app>"
EMAIL_FROM=
# Copia oculta de cada entrega y aviso "Venta #id – ebook – mail ENVIADO/FALLÓ"
OWNER_EMAIL=
# Opcional: a dónde van las respuestas de los compradores
REPLY_TO=

# Panel /admin (mínimo 10 caracteres)
ADMIN_PASSWORD=

# Meta: API de conversiones (Administrador de eventos > tu píxel > Configuración > Generar token de acceso)
META_CAPI_TOKEN=
# Opcional, solo mientras probás en "Probar eventos". Borrala después.
META_TEST_EVENT_CODE=
