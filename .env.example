# Mercado Pago (Tus integraciones > tu aplicación > Credenciales de producción)
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx
# Clave secreta de webhooks (Tus integraciones > Webhooks). Opcional pero recomendada.
MP_WEBHOOK_SECRET=

# Sitio
SITE_URL=https://ludolab.com.ar
PRICE_ARS=11999
PRODUCT_TITLE=100 juegos con dados · Ebook imprimible

# El PDF: URL privada y difícil de adivinar (Vercel Blob, Google Drive con link, S3...)
PDF_URL=https://xxxxx.public.blob.vercel-storage.com/100-juegos-con-dados-XXXXXXXX.pdf
# Cualquier texto largo y aleatorio; firma los links de descarga
DOWNLOAD_SECRET=cambiar-por-un-texto-largo-y-aleatorio

# Email con Resend (resend.com). El dominio del remitente tiene que estar verificado.
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=LudoLab <hola@ludolab.com.ar>
# A este email te avisamos cada venta (y las de WhatsApp si no configuraste la API)
OWNER_EMAIL=

# WhatsApp Cloud API (opcional). Si falta, te llega un email con un link para mandarlo vos en un toque.
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_TEMPLATE=ebook_entrega
WA_TEMPLATE_LANG=es_AR

# Meta: API de conversiones (Administrador de eventos > tu píxel > Configuración > Generar token de acceso)
META_CAPI_TOKEN=
# Opcional, solo mientras probás en "Probar eventos". Borrala después.
META_TEST_EVENT_CODE=
# Lo crea Vercel solo al conectar el Blob al proyecto. Sirve para no mandar dos veces la misma compra.
BLOB_READ_WRITE_TOKEN=
